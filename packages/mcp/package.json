{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for WhatsApp, a stateless consumer of whatsapp-api",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "whatsapp-mcp": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "whatsapp-api-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  }
}
