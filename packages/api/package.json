{
  "name": "whatsapp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp service built on Baileys: SQLite store, media pipeline, REST surface",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "whatsapp-api": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "whatsapp-api-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "7.0.0-rc14",
    "express": "^5.2.1",
    "jimp": "^1.6.1",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hapi/boom": "9.1.4",
    "@types/express": "^5.0.0"
  }
}
